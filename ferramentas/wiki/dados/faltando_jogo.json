  "tipo": "arquivo:translations_game_message.json",
  "paginas": [
   "translations_game_message.json"
  ]
 },
 {
  "texto": "Are you sure you wish to gain Magic XP?",
  "tipo": "arquivo:translations_game_message.json",
  "paginas": [
   "translations_game_message.json"
  ]
 },
 {
  "texto": "The cupboard contains garlic. You take a clove.",
  "tipo": "arquivo:translations_game_message.json",
  "paginas": [
   "translations_game_message.json"
  ]
 },
 {
  "texto": "The flour bin is already empty. You need to place wheat in the hopper upstairs first.",
  "tipo": "arquivo:translations_game_message.json",
  "paginas": [
   "translations_game_message.json"
  ]
 },
 {
  "texto": "The vampyre seems to be weakened by the garlic you're carrying.",
  "tipo": "arquivo:translations_game_message.json",
  "paginas": [
   "translations_game_message.json"
  ]
 },
 {
  "texto": "You can't light a fire here.",
  "tipo": "arquivo:translations_game_message.json",
  "paginas": [
   "translations_game_message.json"
  ]
 },
 {
  "texto": "You can't open the settings interface while in combat.",
  "tipo": "arquivo:translations_game_message.json",
  "paginas": [
   "translations_game_message.json"
  ]
 },
 {
  "texto": "You can't use that teleport at the moment.",
  "tipo": "arquivo:translations_game_message.json",
  "paginas": [
   "translations_game_message.json"
  ]
 },
 {
  "texto": "You do not have enough Mind Runes to cast this spell.",
  "tipo": "arquivo:translations_game_message.json",
  "paginas": [
   "translations_game_message.json"
  ]
 },
 {
  "texto": "You dye the wig blonde.",
